# Copy to .env on the VM and fill in. NEVER commit .env. All names, no values.

NODE_ENV=production
PORT=4000

# MySQL (same VM)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Google OAuth 2.0 — your own app in Google Cloud Console.
# Authorized redirect URI must equal: ${PUBLIC_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL of the API behind ngrok. Use ngrok's free STATIC domain so it
# survives restarts, otherwise the OAuth redirect and form links break.
PUBLIC_BASE_URL=https://your-static-name.ngrok-free.app

# Where the React app is served (CORS + post-login redirect).
# ORIGIN ÚNICO (recomendado): o próprio server serve o front (app/dist), então
# APP_ORIGIN = PUBLIC_BASE_URL. Em dev com Vite à parte, use http://localhost:5173.
APP_ORIGIN=https://your-static-name.ngrok-free.app

# Random secret (>=16 chars) for session cookies. Generate, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Allowlist de login (uso interno atrás de túnel público). EM PRODUÇÃO, defina
# pelo menos um — senão o login falha fechado (ninguém entra). Em dev, vazio =
# qualquer um entra. Separados por vírgula.
ALLOWED_EMAIL_DOMAINS=suaempresa.com
ALLOWED_EMAILS=
