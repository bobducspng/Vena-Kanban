{
  "name": "replica-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "test:conditions": "tsx test/conditions.check.ts"
  },
  "dependencies": {
    "@trpc/server": "^11.19.0",
    "cookie": "^0.7.2",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
