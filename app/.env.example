# Copy to .env.local. URL base da API.
#
# ORIGIN ÚNICO (produção recomendada): o server serve o front, então API e front
# ficam no MESMO endereço. Deixe VAZIO para usar caminhos relativos (/trpc, /auth):
#   VITE_API_URL=
#
# DEV (Vite + server separados): aponte para o server local:
#   VITE_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
